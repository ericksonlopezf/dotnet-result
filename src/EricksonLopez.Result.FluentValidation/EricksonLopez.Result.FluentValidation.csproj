<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright © Erickson Lopez. MIT License. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EricksonLopez.Result.FluentValidation</AssemblyName>
    <RootNamespace>EricksonLopez.Result.FluentValidation</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.Result.FluentValidation</PackageId>
    <Authors>Erickson Lopez</Authors>
    <Company>Erickson Lopez</Company>
    <Description>FluentValidation integration for EricksonLopez.Result. Converts FluentValidation.ValidationResult to Result failures with structured error metadata.</Description>
    <PackageProjectUrl>https://ericksonlopez.dev/result</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericksonlopezf/dotnet-result</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>$(CommonPackageTags);result;fluentvalidation;validation;native-aot</PackageTags>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Result\EricksonLopez.Result.csproj" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>
</Project>


