<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <PackageId>EricksonLopez.Result.Analyzers</PackageId>
    <Authors>Erickson Lopez</Authors>
    <Company>Erickson Lopez</Company>
    <Copyright>Copyright © 2026 Erickson Lopez</Copyright>
    <Description>Roslyn analyzers and code fixes for EricksonLopez.Result: detects closure allocations in Result pipelines (RESULT004), discarded ErrorBuilder return values with auto-fix (RESULT003), oversized Result value types (RESULT001), chained Error.WithMetadata() allocations (RESULT005), chained ErrorBuilder.WithInnerError() patterns (RESULT006), HashSet&lt;Error&gt;/Dictionary&lt;Error,...&gt; and LINQ Distinct/GroupBy/ToHashSet without ErrorEqualityComparer.Strict (RESULT007), endpoint filter OpenAPI degradation (RESULT008), and ResultHttpOptions.IncludeDescription=true without environment guard (RESULT009 - security).</Description>
    <PackageProjectUrl>https://github.com/ericksonlopez/dotnet-result</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericksonlopez/dotnet-result</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>roslyn;analyzer;codefix;result;railway;functional</PackageTags>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);RS1036;RS2008;NU5128</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Analyzers are not intended to be referenced directly; they are installed as NuGet analyzers -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <!-- Required for CodeFixProvider, ExportCodeFixProvider, and CodeAction APIs -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.12.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Place the analyzer and code fix DLL in the correct NuGet analyzer directory -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\$(AssemblyName).xml" Pack="true" PackagePath="analyzers/dotnet/cs" Condition="Exists('$(OutputPath)\$(AssemblyName).xml')" Visible="false" />
  </ItemGroup>

  <!-- Prevent global PublishAot=true from failing the analyzer build -->
  <Target Name="_ClearPublishAot" BeforeTargets="ProcessFrameworkReferences">
    <PropertyGroup>
      <PublishAot>false</PublishAot>
      <IsAotCompatible>false</IsAotCompatible>
      <PublishTrimmed>false</PublishTrimmed>
      <IsTrimmable>false</IsTrimmable>
      <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>
  </Target>
</Project>

