<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright © Erickson Lopez. MIT License. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EricksonLopez.Result.MassTransit</AssemblyName>
    <RootNamespace>EricksonLopez.Result.MassTransit</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.Result.MassTransit</PackageId>
    <Description>MassTransit pipeline integration for EricksonLopez.Result. Translates domain Result failures into structured message bus faults.</Description>
    <PackageProjectUrl>https://ericksonlopez.dev/result</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericksonlopezf/dotnet-result</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>$(CommonPackageTags);result;masstransit;messaging;service-bus;fault-handling;event-driven</PackageTags>
    <Nullable>enable</Nullable>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Result\EricksonLopez.Result.csproj" />
    <PackageReference Include="MassTransit.Abstractions" />
  </ItemGroup>
</Project>
