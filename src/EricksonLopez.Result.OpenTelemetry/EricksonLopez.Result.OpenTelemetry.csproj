<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright © Erickson Lopez. MIT License. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EricksonLopez.Result.OpenTelemetry</AssemblyName>
    <RootNamespace>EricksonLopez.Result.OpenTelemetry</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.Result.OpenTelemetry</PackageId>
    <Authors>Erickson Lopez</Authors>
    <Company>Erickson Lopez</Company>
    <Copyright>Copyright © 2026 Erickson Lopez</Copyright>
    <Description>OpenTelemetry ActivitySource tracing and Metrics integration for EricksonLopez.Result.</Description>
    <PackageProjectUrl>https://ericksonlopez.dev/result</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericksonlopezf/dotnet-result</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>$(CommonPackageTags);opentelemetry;telemetry;observability;tracing;metrics;activitysource;distributed-tracing;native-aot</PackageTags>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\EricksonLopez.Result\EricksonLopez.Result.csproj" />
    <!-- Source generator: emits ResultMetricsVersionConstants.g.cs at build time,
         providing the version as a compile-time const string without runtime reflection.
         This aligns with the library's performance philosophy:
         "prefer source generators over reflection for maximum performance and NativeAOT compatibility." -->
    <ProjectReference Include="..\EricksonLopez.Result.Serialization.Generators\EricksonLopez.Result.Serialization.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Result.OpenTelemetry.Tests" Key="$(PublicKey)" />
  </ItemGroup>
</Project>


