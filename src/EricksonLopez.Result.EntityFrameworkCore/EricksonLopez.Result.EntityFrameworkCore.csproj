<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright © Erickson Lopez. MIT License. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EricksonLopez.Result.EntityFrameworkCore</AssemblyName>
    <RootNamespace>EricksonLopez.Result.EntityFrameworkCore</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.Result.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core integration for EricksonLopez.Result. Converts DbContext and IQueryable operations to Result with structured error taxonomy mapping.</Description>
    <PackageProjectUrl>https://ericksonlopez.dev/result</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericksonlopezf/dotnet-result</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>$(CommonPackageTags);result;efcore;entity-framework-core;orm;database;native-aot</PackageTags>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Result\EricksonLopez.Result.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
</Project>
