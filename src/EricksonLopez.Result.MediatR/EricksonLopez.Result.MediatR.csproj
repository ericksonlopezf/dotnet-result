<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EricksonLopez.Result.MediatR</AssemblyName>
    <RootNamespace>EricksonLopez.Result.MediatR</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.Result.MediatR</PackageId>
    <Authors>Erickson Lopez</Authors>
    <Company>Erickson Lopez</Company>
    <Copyright>Copyright © 2026 Erickson Lopez</Copyright>
    <Description>MediatR pipeline behavior integration for EricksonLopez.Result. Provides Result-aware validation and exception handling behaviors.</Description>
    <PackageProjectUrl>https://github.com/ericksonlopez/dotnet-result</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericksonlopez/dotnet-result</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>result;mediatr;cqrs;pipeline;behavior;error-handling</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MediatR itself uses reflection; AOT is not supported -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Result\EricksonLopez.Result.csproj" />
    <PackageReference Include="MediatR" Version="12.4.1" />
  </ItemGroup>
</Project>
