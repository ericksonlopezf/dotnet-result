<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA1852;CA1305;CS0619;CS0618;xUnit1051</NoWarn>
    <!-- CS0619: Suppressed in test project only - tests intentionally cover the error-obsolete
         ResultJsonConverterFactory to verify its behavior for consumers who explicitly opt in
         via #pragma warning disable CS0619 in production code.
         CS0618: Suppressed to allow tests to call Obsolete-marked methods for backward-compat regression.
         xUnit1051: Suppressed because tests use CancellationToken.None intentionally for deterministic
         test behavior. TestContext.Current.CancellationToken is not appropriate for all test scenarios. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.5.0" />
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NSubstitute" Version="6.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- xunit.v3.assert is pulled as a transitive dependency of xunit.analyzers (via xunit.runner.visualstudio).
         It conflicts with xunit.assert v2 causing CS0433 ambiguous type errors.
         We exclude it from compile assets since xunit v2 assert is the target version. -->
    <PackageReference Include="xunit.v3.assert" Version="1.0.0">
      <ExcludeAssets>compile</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.Testing.XUnit\EricksonLopez.Result.Testing.XUnit.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.Analyzers\EricksonLopez.Result.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.Serialization.Generators\EricksonLopez.Result.Serialization.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EricksonLopez.Result\EricksonLopez.Result.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.AspNetCore\EricksonLopez.Result.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.Serialization\EricksonLopez.Result.Serialization.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.OpenTelemetry\EricksonLopez.Result.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.Testing\EricksonLopez.Result.Testing.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.FluentValidation\EricksonLopez.Result.FluentValidation.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.MediatR\EricksonLopez.Result.MediatR.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.Testing.NUnit\EricksonLopez.Result.Testing.NUnit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <PropertyGroup>
    <Include>[EricksonLopez.Result]*,[EricksonLopez.Result.*]*</Include>
    <Exclude>[EricksonLopez.Result.Analyzers]*,[EricksonLopez.Result.Serialization.Generators]*</Exclude>
  </PropertyGroup>
</Project>