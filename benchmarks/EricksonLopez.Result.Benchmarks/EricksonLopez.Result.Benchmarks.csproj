<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright © Erickson Lopez. MIT License. -->
  <PropertyGroup>
    <!-- Multi-target so BenchmarkDotNet can spawn worker processes for each TFM.
         net10.0 is required for RuntimeMoniker.Net100 in BDN 0.15.x.
         net8.0 is included for cross-version comparison when installed. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Benchmarks are not AOT-compatible due to BenchmarkDotNet internals -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <!-- Benchmark methods use underscores for readability and cannot be static -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;CA1822;CA1305;CS1591;CA1716;CA1000;CA1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0.15.8 adds RuntimeMoniker.Net100 for .NET 10.0 benchmark jobs -->
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EricksonLopez.Result\EricksonLopez.Result.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.Serialization\EricksonLopez.Result.Serialization.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Result.MediatR\EricksonLopez.Result.MediatR.csproj" />
  </ItemGroup>
</Project>

