# =============================================================================
# .NET Build Outputs & Artifacts
# =============================================================================
[Bb]in/
[Oo]bj/
[Aa]rtifacts/
[Nn]upkgs/
*.nupkg
*.snupkg
aot-output/
*.binlog

# Source Generator emitted files (when debugging generators)
GeneratedFiles/
**/[Gg]enerated/

# Backup and temp files
*.bak
*.tmp

# =============================================================================
# Security & Cryptographic Keys (Strict Zero-Leak Policy)
# =============================================================================
*.pfx
*.p12
*.snk
# Safe public key only (contains NO private key)
!public.snk

# =============================================================================
# Secrets & Environment Configurations
# =============================================================================
appsettings.Development.json
appsettings.Local.json
secrets.json
.env
.env.*
!.env.example

# =============================================================================
# Visual Studio / VS Code / JetBrains Rider / ReSharper
# =============================================================================
# Visual Studio
.vs/
*.user
*.userosv
*.suo
*.sln.docstates
*.userprefs
*.slnx.sqlite

# JetBrains Rider & ReSharper
.idea/
_ReSharper.Caches/
*.DotSettings.user

# Visual Studio Code (track shared tasks/launch/settings; ignore user state)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# =============================================================================
# Testing, Coverage & Stryker.NET Artifacts
# =============================================================================
[Tt]est[Rr]esults*/
[Cc]overage[Rr]eport*/
*.trx
*.coverage
*.coveragexml
*.cobertura.xml
*.opencover.xml
coverage.*/
**/coverage.*.xml
**/coverage.*.cobertura.xml
**/coverage.*.opencover.xml

# Stryker.NET
StrykerOutput/
.stryker-tmp/
.stryker-baseline/

# BenchmarkDotNet (keep baseline.json tracked, ignore raw artifacts & logs)
BenchmarkDotNet.Artifacts/
benchmarks/results/*.log

# Crash dumps & native diagnostic traces
*.dmp
*.core
*.diaglog

# =============================================================================
# OS Specific Files
# =============================================================================
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*

# =============================================================================
# Documentation Build Artifacts
# =============================================================================
docs/*.html
