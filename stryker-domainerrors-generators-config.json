{
    "stryker-config":  {
                           "project":  "EricksonLopez.Result.DomainErrors.Generators.csproj",
                           "test-projects":  [
                                                 "EricksonLopez.Result.DomainErrors.Generators.Tests.csproj"
                                             ],
                           "mutate":  [
                                          "**/*.cs",
                                          "!bin/**",
                                          "!obj/**",
                                          "!**/*.g.cs",
                                          "!**/*.AssemblyInfo.cs"
                                      ],
                           "thresholds":  {
                                              "high":  100,
                                              "low":  98,
                                              "break":  95
                                          },
                           "reporters":  [
                                             "html",
                                             "json",
                                             "cleartext",
                                             "progress"
                                         ],
                           "ignore-methods":  [
                                                  "ConfigureAwait",
                                                  "Dispose"
                                              ],
                           "concurrency":  2
                       }
}
